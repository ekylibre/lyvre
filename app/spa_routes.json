{
  "_comment": "Pages servies par la SPA React (claudedocs/design_front_mantine.md §4.1). rule = règle Flask, endpoint = nom url_for gardé pour les liens Jinja, public = sans connexion. Lu par app/spa.py et frontend/src/app/routes.ts.",
  "routes": [
    {"rule": "/login", "endpoint": "auth.login", "public": true},
    {"rule": "/select-instance", "endpoint": "auth.select_instance"},
    {"rule": "/journals/", "endpoint": "journals.index"},
    {"rule": "/journals/new", "endpoint": "journals.new"},
    {"rule": "/fiscal-years/", "endpoint": "fiscal_years.index"},
    {"rule": "/fiscal-years/new", "endpoint": "fiscal_years.new"},
    {"rule": "/accounts/", "endpoint": "accounts.index"},
    {"rule": "/accounts/new", "endpoint": "accounts.new"},
    {"rule": "/accounts/<int:account_id>/edit", "endpoint": "accounts.edit"},
    {"rule": "/products/", "endpoint": "products.index"},
    {"rule": "/products/new", "endpoint": "products.new"},
    {"rule": "/products/<int:product_id>/edit", "endpoint": "products.edit"},
    {"rule": "/rules/", "endpoint": "rules.index"},
    {"rule": "/rules/new", "endpoint": "rules.new"},
    {"rule": "/rules/<int:rule_id>/edit", "endpoint": "rules.edit"},
    {"rule": "/work-times/task-types", "endpoint": "work_times.task_types"},
    {"rule": "/work-times/task-types/new", "endpoint": "work_times.task_type_new"},
    {"rule": "/work-times/task-types/<int:task_type_id>/edit", "endpoint": "work_times.task_type_edit"},
    {"rule": "/users/", "endpoint": "users.index"},
    {"rule": "/users/new", "endpoint": "users.new"},
    {"rule": "/users/<int:user_id>/edit", "endpoint": "users.edit"},
    {"rule": "/entities/", "endpoint": "entities.index"},
    {"rule": "/entities/new", "endpoint": "entities.new"},
    {"rule": "/entities/<int:entity_id>", "endpoint": "entities.detail"},
    {"rule": "/entities/<int:entity_id>/edit", "endpoint": "entities.edit"},
    {"rule": "/entities/members", "endpoint": "entities.members"},
    {"rule": "/entities/members/reminders", "endpoint": "entities.members_reminders"},
    {"rule": "/entities/members/reminder-template", "endpoint": "entities.reminder_template"},
    {"rule": "/work-times/", "endpoint": "work_times.index"},
    {"rule": "/work-times/new", "endpoint": "work_times.new"},
    {"rule": "/work-times/<int:work_time_id>/edit", "endpoint": "work_times.edit"},
    {"rule": "/work-times/import", "endpoint": "work_times.import_view"},
    {"rule": "/", "endpoint": "dashboard.index"},
    {"rule": "/entries/", "endpoint": "entries.index"},
    {"rule": "/entries/new", "endpoint": "entries.new"},
    {"rule": "/entries/<int:entry_id>", "endpoint": "entries.detail"},
    {"rule": "/entries/<int:entry_id>/edit", "endpoint": "entries.edit"},
    {"rule": "/reports/balance", "endpoint": "reports.balance"},
    {"rule": "/reports/grand-livre", "endpoint": "reports.grand_livre"},
    {"rule": "/reports/bilan", "endpoint": "reports.bilan"},
    {"rule": "/reports/compte-de-resultat", "endpoint": "reports.compte_resultat"}
  ]
}
