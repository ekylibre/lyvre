---
// Une version publiée : actions requises en tête (encadré), puis nouveautés, améliorations, corrections.
import { byKind, formatDate, inline, KINDS, splitEntry, STRUCTURES, type Version } from "../lib/data";

interface Props {
  release: Version;
  heading?: "h1" | "h2";
}
const { release, heading = "h2" } = Astro.props;
const Heading = heading;
---

<section class="release" id={`v${release.version}`}>
  <Heading>
    {heading === "h2" ? <a href={`/nouveautes/${release.version}/`}>{release.version} · {release.title}</a> : `${release.version} · ${release.title}`}
  </Heading>
  <p class="muted"><time datetime={release.date}>{formatDate(release.date)}</time></p>
  {byKind(release.entries).map(([kind, entries]) => (
    <div class={kind === "action" ? "action" : undefined}>
      <h3>{kind === "action" ? "⚠️ " : ""}{KINDS[kind]}</h3>
      <ul>
        {entries.map((e) => {
          const { where, what } = splitEntry(e.text);
          return (
            <li>
              {e.structure && <span class="tag">{STRUCTURES[e.structure]}</span>}
              {where && <span class="where">{where} : </span>}
              <span set:html={inline(what)} />
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</section>
