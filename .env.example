# Lyvre — exemple de configuration. Copier en .env, puis remplacer les valeurs « à-changer ».
# Détail de chaque variable : doc/docker.md (section « Variables d'environnement »).

# --- Obligatoire ---------------------------------------------------------------------------------
# Clé de session et de signature des liens (mot de passe oublié) : longue et aléatoire, par exemple
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=à-changer
# Compte administrateur créé au premier démarrage (modifiable ensuite dans /users/).
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=à-changer

# --- Recommandé ----------------------------------------------------------------------------------
# Adresse publique de Lyvre (liens envoyés par e-mail).
APP_BASE_URL=http://localhost:5000
# Plan comptable de la première structure si sa base est vide : asso ou sci.
DEFAULT_INSTANCE_CHART=asso

# --- E-mails de la plateforme (mot de passe oublié) ----------------------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Services du serveur (facultatifs) -----------------------------------------------------------
# API Sirene v4 de l'INSEE (portail-api.insee.fr) : pré-remplissage de la Structure et des tiers.
SIRENE_API_KEY=

# Les intégrations de chaque structure (Qonto, HelloAsso, Brevo, Stancer, Odoo, SMTP, Documenso…)
# se configurent dans l'application : Configuration › Intégrations.
