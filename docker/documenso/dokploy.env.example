# Onglet Environment du service Documenso dans Dokploy (seconde-nature-kvm). Ne jamais versionner les
# valeurs réelles. Secrets : openssl rand -hex 32 (un par ligne).
POSTGRES_USER=documenso
POSTGRES_PASSWORD=
POSTGRES_DB=documenso
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=
NEXT_PUBLIC_WEBAPP_URL=https://signature.seconde-nature.net
NEXT_PUBLIC_DISABLE_SIGNUP=false
NEXT_PRIVATE_SMTP_HOST=
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_FROM_NAME=Signature des baux
NEXT_PRIVATE_SMTP_FROM_ADDRESS=
# base64 -w0 cert.p12
NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS=
NEXT_PRIVATE_SIGNING_PASSPHRASE=
